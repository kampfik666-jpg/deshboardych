BOT_TOKEN=put_your_token_here
# ID чата, куда слать брифинг (узнай командой /id у бота). Можно несколько через запятую.
TELEGRAM_CHAT_ID=

DB_PATH=data/lifehub.sqlite3
UPLOAD_DIR=data/uploads
TIMEZONE=Asia/Yekaterinburg

# Во сколько присылать утренний брифинг (24ч, локальное время)
BRIEFING_TIME=06:00
# Полировать ли брифинг через LLM (иначе шаблонный текст)
BRIEFING_USE_LLM=true

# --- LLM (любой OpenAI-совместимый API: OpenAI, OpenRouter, AnyModel, прокси) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Проверенные рабочие модели AnyModel (https://anymodel.org/v1):
#   ag/gemini-2.5-flash, glm/glm-5.3-flash, xai/grok-4.3, claude-haiku-4-5-20251001

# --- Яндекс 360 (почта + календарь) ---
# Включи IMAP в настройках Яндекс Почты и создай "пароль приложения"
YANDEX_ENABLED=false
YANDEX_LOGIN=
YANDEX_MAIL_PASSWORD=
YANDEX_CALDAV_PASSWORD=

# --- Google (Gmail + Google Calendar) ---
# Нужна двухфакторка и "пароль приложения"; IMAP включи в настройках Gmail
GOOGLE_ENABLED=false
GOOGLE_EMAIL=
GOOGLE_MAIL_PASSWORD=
GOOGLE_CALDAV_PASSWORD=

# Как часто синхронизировать почту и календари (минуты)
SYNC_EVERY_MINUTES=30
# Сколько дней почты подтягивать
MAIL_SINCE_DAYS=7
MAIL_FETCH_LIMIT=50

# Погода в брифинге (open-meteo, ключ не нужен). Пусто = без погоды.
WEATHER_CITY=Екатеринбург

# Веб-дашборд
WEB_HOST=127.0.0.1
WEB_PORT=8765

# --- Мини-апп Telegram (бесплатный туннель Cloudflare) ---
# При запуске поднимается туннель и кнопка-мини-апп вешается на меню бота.
# Внешний доступ защищён токеном (генерируется автоматически, хранится в БД).
MINIAPP_ENABLED=true
# Можно задать свой постоянный токен (иначе сгенерируется сам):
WEB_APP_TOKEN=
